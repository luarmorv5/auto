-- Sistema avanzado de resolución de assets:
-- 1. Soporta URLs web (Discord, Imgur, Github) usando getcustomasset si el executor lo soporta
-- 2. Intenta extraer Texture de Decals via game:GetObjects si es posible
-- 3. Usa rbxthumb://type=Asset&id=...&w=420&h=420 para cargar Decals en ImageLabel
local function resolveAsset(input)
    if not input or input == "" then return FALLBACK_ICON end

    -- Si es una URL web externa
    if type(input) == "string" and (input:match("^https?://") or input:match("^http?://")) then
        local gca = getcustomasset or getsynasset
        if gca and writefile and isfile and readfile then
            local fName = "AuroraX/custom_logo.png"
            if isfolder and makefolder and not isfolder("AuroraX") then pcall(makefolder, "AuroraX") end
            local ok, data = pcall(function() return game:HttpGet(input) end)
            if ok and data and #data > 0 then
                pcall(writefile, fName, data)
                local okAsset, asset = pcall(gca, fName)
                if okAsset and asset then return asset end
            end
        end
    end

    -- Si ya es un asset rbx directo
    if type(input) == "string" and (input:match("^rbxthumb://") or input:match("^rbxasset://")) then
        return input
    end

    local num = tostring(input):match("(%d+)")
    if num then
        -- En ejecutores con nivel de permisos suficiente, GetObjects extrae el Image ID real de la Decal:
        local ok, objs = pcall(function() return game:GetObjects("rbxassetid://" .. num) end)
        if ok and objs and objs[1] then
            local item = objs[1]
            if item:IsA("Decal") and item.Texture and item.Texture ~= "" then
                return item.Texture
            end
        end

        -- Protocolo oficial para pintar Decals o Assets en ImageLabels
        return "rbxthumb://type=Asset&id=" .. num .. "&w=420&h=420"
    end

    return tostring(input)
end

-- Embedded Custom Logo Asset (160x160 Gothic Artwork Base64)
local B64_LOGO_DATA = ""

local b64chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local b64lookup = {}
for i = 1, #b64chars do b64lookup[b64chars:sub(i, i)] = i - 1 end

local function decodeBase64(data)
    local cryptDec = (crypt and (crypt.base64decode or crypt.base64_decode))
        or (syn and syn.crypt and syn.crypt.base64_decode)
        or (base64 and base64.decode)
        or base64_decode
    if cryptDec then
        local ok, res = pcall(cryptDec, data)
        if ok and res and #res > 0 then return res end
    end
    data = string.gsub(data, "[^" .. b64chars .. "=]", "")
    return (data:gsub("....", function(x)
        if #x < 4 then return "" end
        local c1, c2, c3, c4 = x:sub(1,1), x:sub(2,2), x:sub(3,3), x:sub(4,4)
        local b1, b2 = b64lookup[c1], b64lookup[c2]
        if not b1 or not b2 then return "" end
        local r = string.char((b1 * 4 + math.floor(b2 / 16)) % 256)
        if c3 ~= "=" then
            local b3 = b64lookup[c3]
            if b3 then
                r = r .. string.char((b2 * 16 + math.floor(b3 / 4)) % 256)
                if c4 ~= "=" then
                    local b4 = b64lookup[c4]
                    if b4 then
                        r = r .. string.char((b3 * 64 + b4) % 256)
                    end
                end
            end
        end
        return r
    end))
end

