    isSkillReady = function(skillFrame, key, curTool)
        if not skillFrame then return false end
        local kf = skillFrame:FindFirstChild(key)
        if not kf or not kf.Visible then return false end

        -- 1. Weapon Category Key Legality & Fruit V check
        local tool = curTool or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool"))
        if tool then
            if isToolMatchingType(tool, "Sword") or isToolMatchingType(tool, "Gun") then
                if key == "C" or key == "V" or key == "F" then return false end
            elseif isToolMatchingType(tool, "Melee") then
                if key == "V" or key == "F" then return false end
            elseif isToolMatchingType(tool, "Blox Fruit") then
                if key == "V" and isFruitVBlocked() then return false end
            end
        elseif key == "V" and isFruitVBlocked() then
            return false
        end

        -- 2. Check Cooldown (Project Spooky: Cooldown.AbsoluteSize.X <= 0 means ready)
        local cd = kf:FindFirstChild("Cooldown") or kf:FindFirstChild("Bar") or kf:FindFirstChild("Cd")
        if cd and cd:IsA("GuiObject") then
            if cd.AbsoluteSize and cd.AbsoluteSize.X > 0 then return false end
        end

        -- 3. Check UI Mastery / Lock Indicators
        if kf:GetAttribute("Locked") == true or kf:GetAttribute("Unlocked") == false then
            return false
        end

        local lockObj = kf:FindFirstChild("Lock") or kf:FindFirstChild("Locked") or kf:FindFirstChild("Padlock")
        if lockObj and lockObj:IsA("GuiObject") and lockObj.Visible then
            return false
        end

        -- 4. Check Tool Mastery Level (Blox Fruits weapon Level IntValue)
        if tool then
            local toolLvl = (tool:FindFirstChild("Level") and tool.Level:IsA("ValueBase") and tonumber(tool.Level.Value))
                or tonumber(tool:GetAttribute("Level"))
                or tonumber(tool:GetAttribute("Mastery"))

            -- If a specific numeric level is explicitly present on the tool (> 1), verify thresholds
            if toolLvl and toolLvl > 1 then
                local toolName = string.lower(tool.Name)
                -- High-tier specific weapons
                if string.find(toolName, "guitar") or string.find(toolName, "skull") then
                    if key == "X" and toolLvl < 250 then return false end
                    if key == "Z" and toolLvl < 125 then return false end
                elseif string.find(toolName, "cursed dual") or string.find(toolName, "cdk") then
                    if key == "X" and toolLvl < 350 then return false end
