local ActivePopup, PopupBlocker = nil, nil

closePopup = function()
    if PopupBlocker then PopupBlocker:Destroy(); PopupBlocker = nil end
    if ActivePopup then ActivePopup:Destroy(); ActivePopup = nil end
end

local function openPopup(anchor, width, items)
    closePopup()
    local base   = ScreenGui.AbsolutePosition
    local screen = ScreenGui.AbsoluteSize
    local ap, as = anchor.AbsolutePosition, anchor.AbsoluteSize
    local itemH  = 20
    local rawHeight = #items * itemH + 8
    local maxHeight = math.min(180, screen.Y - 20)
    local isScrollable = rawHeight > maxHeight
    local height = isScrollable and maxHeight or rawHeight

    local x = ap.X - base.X + as.X - width
    local y = ap.Y - base.Y + as.Y + 4
    if y + height > screen.Y - 4 then
        y = ap.Y - base.Y - height - 4
    end
    x = math.clamp(x, 4, math.max(4, screen.X - width - 4))
    y = math.clamp(y, 4, math.max(4, screen.Y - height - 4))

    PopupBlocker = create("TextButton", {
        Name = "PopupBlocker",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        ZIndex = 99,
        Parent = ScreenGui,
    })
    PopupBlocker.Activated:Connect(closePopup)
    PopupBlocker.MouseButton1Click:Connect(closePopup)
    PopupBlocker.MouseButton1Down:Connect(closePopup)
    PopupBlocker.MouseButton2Down:Connect(closePopup)
    if PopupBlocker.TouchTap then PopupBlocker.TouchTap:Connect(closePopup) end
    PopupBlocker.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            closePopup()
        end
    end)

    local popup = create(isScrollable and "ScrollingFrame" or "Frame", {
        Name = "Popup",
        Position = UDim2.fromOffset(x, y),
        Size = UDim2.fromOffset(width, height),
        BackgroundColor3 = THEME.PopupBg,
        BorderSizePixel = 0,
        ZIndex = 100,
        Parent = ScreenGui,
    })
    if isScrollable then
        popup.ScrollBarThickness = 3
        popup.ScrollBarImageColor3 = THEME.Accent
        popup.CanvasSize = UDim2.new(0, 0, 0, rawHeight)
    end
    addCorner(popup, 6)
    addStroke(popup, THEME.Border, 1)
    addPadding(popup, 4, 4, 4, 4)
    addList(popup, 0)

    local sc = create("UIScale", {Scale = 0.9, Parent = popup})
    tween(sc, TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1})

    for i, item in ipairs(items) do
        local b = create("TextButton", {
            Size = UDim2.new(1, 0, 0, itemH),
            BackgroundColor3 = THEME.SidebarActive,
            BackgroundTransparency = 1,
            Text = item.Text,
            Font = Enum.Font.GothamMedium,
            TextSize = 10,
            TextColor3 = item.Selected and THEME.Accent or THEME.TextPrimary,
            TextXAlignment = Enum.TextXAlignment.Left,
            AutoButtonColor = false,
            LayoutOrder = i,
            Parent = popup,
        })
        addCorner(b, 4)
        addPadding(b, 0, 0, 6, 6)
        b.MouseEnter:Connect(function() tween(b, TWEEN_FAST, {BackgroundTransparency = 0}) end)
        b.MouseLeave:Connect(function() tween(b, TWEEN_FAST, {BackgroundTransparency = 1}) end)

        local function selectItem()
            closePopup()
            if item.Callback then item.Callback() end
        end
        b.Activated:Connect(selectItem)
        b.MouseButton1Click:Connect(selectItem)
    end

    ActivePopup = popup
end

