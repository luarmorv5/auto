    box.MouseEnter:Connect(function() tween(boxStroke, TWEEN_FAST, {Color = THEME.BorderActive}) end)
    box.MouseLeave:Connect(function() tween(boxStroke, TWEEN_FAST, {Color = THEME.Border}) end)

    local obj = {
        Instance = box,
        Value = default,
    }

    function obj.Set(selfOrVal, valOrSilent, maybeSilent)
        local v, silent
        if type(selfOrVal) == "table" and selfOrVal == obj then
            v, silent = valOrSilent, maybeSilent
        else
            v, silent = selfOrVal, valOrSilent
        end
        if not table.find(options, v) then v = default end
        obj.Value = v
        Flags[flag] = v
        valueLbl.Text = tostring(v)
        if opts.Callback and not silent then task.spawn(opts.Callback, v) end
    end

    function obj.Refresh(selfOrNew, maybeNew)
        local newOptions = (type(selfOrNew) == "table" and selfOrNew == obj) and maybeNew or selfOrNew
        options = newOptions or {}
        if not table.find(options, obj.Value) then obj.Set(options[1]) end
    end

    local function openDropdownMenu()
        local items = {}
        for _, o in ipairs(options) do
            table.insert(items, {Text = tostring(o), Selected = (o == obj.Value), Callback = function() obj.Set(o) end})
        end
        tween(chev, TWEEN_FAST, {Rotation = 180})
        openPopup(box, math.max(box.AbsoluteSize.X, 100), items)
        local p = ActivePopup
        if p then
            p.Destroying:Connect(function()
                if chev.Parent then tween(chev, TWEEN_FAST, {Rotation = 0}) end
            end)
        end
    end
    box.Activated:Connect(openDropdownMenu)
    box.MouseButton1Click:Connect(openDropdownMenu)

    register(flag, default, function(v) obj.Set(v) end)
    obj.Set(default, true)
    table.insert(Aurora.UI.Elements, obj)
    return obj
end

