                                else
                                    if AX_InSafeZone(curTarg) then
                                        updateTelemetryLog("[Hunt] Target entered SafeZone: " .. tostring(curTarg.DisplayName or curTarg.Name))
                                        SkipPlayer(false)
                                    else
                                        to(gotoPos)
                                    end
                                end
                            end
                        end
                    else
                        -- No target available: Idle wait without forced 2000 studs sky ascent
                        task.wait(0.5)
                    end
                end
            end
        end)

