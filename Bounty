local hintShown = false

local function minimize()
    if isMinimized or isAnimating then return end
    isAnimating, isMinimized = true, true
    closePopup()
    SearchInput:ReleaseFocus()
    savedPosition = Main.Position

    local target = MiniHolder.Position
    local Tw = Aurora.Tweens
    tween(Main, Tw.MinIn, {Position = target})
    tween(MainScale, Tw.MinIn, {Scale = 0.05})
    tween(Glow, Tw.MinIn, {ImageTransparency = 1})
    tween(OutlineStroke, Tw.MinIn, {Transparency = 1})

    task.delay(Tw.MinIn.Time, function()
        if not ScreenGui.Parent then return end
        Main.Visible = false
        MiniHolder.Visible = true
        MiniScale.Scale = 0
        THEME.MiniLogo.Rotation = -140
        tween(MiniScale, Tw.PopOut, {Scale = 1})
        tween(THEME.MiniLogo, TweenInfo.new(0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Rotation = 0})
        task.delay(Tw.PopOut.Time, function() isAnimating = false end)
        if not hintShown then
            hintShown = true
            notify("Aurora X", "Click the toggle or press " .. shortKey(MenuKey) .. " to open", 3)
        end
    end)
end

local function restore()
    if not isMinimized or isAnimating then return end
    isAnimating = true
    local Tw = Aurora.Tweens
    tween(MiniScale, Tw.PopIn, {Scale = 0})
    tween(THEME.MiniLogo, Tw.PopIn, {Rotation = 90})

    task.delay(Tw.PopIn.Time, function()
        if not ScreenGui.Parent then return end
        MiniHolder.Visible = false
        Main.Position = MiniHolder.Position
        MainScale.Scale = 0.05
        Main.Visible = true
        tween(Main, Tw.RestorePos, {Position = savedPosition})
        tween(MainScale, Tw.RestoreScl, {Scale = UIScaleValue})
        tween(Glow, Tw.RestorePos, {ImageTransparency = 0.8})
        tween(OutlineStroke, Tw.RestorePos, {Transparency = 0})
        task.delay(Tw.RestoreScl.Time, function()
            isAnimating, isMinimized = false, false
        end)
    end)
end

toggleMinimize = function()
    if isMinimized then restore() else minimize() end
end

