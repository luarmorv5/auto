-- CONFIGS (writefile / readfile)
-- =============================================================================
do
    local canSave = (writefile and readfile and isfile) and true or false
    local AUTOLOAD_FILE = CONFIG_FOLDER .. "/autoload.txt"

    local function ensureFolder()
        if isfolder and makefolder and not isfolder(CONFIG_FOLDER) then
            makefolder(CONFIG_FOLDER)
        end
    end

    local function configPath(slot)
        local clean = string.gsub(slot, "%s", "_")
        return CONFIG_FOLDER .. "/" .. clean .. ".json"
    end

    local function isConfigFlag(k)
        return string.sub(k, 1, 8) == "Configs/"
    end

    local function saveConfig(slot)
        if not canSave then notify("Configs", "Your executor doesn't support writefile", 3) return end
        ensureFolder()
        local data = {}
        for k, v in pairs(Flags) do
            if not isConfigFlag(k) then data[k] = v end
        end
        local ok = pcall(writefile, configPath(slot), HttpService:JSONEncode(data))
        notify("Configs", ok and ("Saved " .. slot) or "Failed to save", 3)
    end

    local function loadConfig(slot, quiet)
        if not canSave then notify("Configs", "Your executor doesn't support readfile", 3) return end
        local path = configPath(slot)
        if not isfile(path) then
            if not quiet then notify("Configs", slot .. " is empty", 3) end
            return
        end
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
        if not ok or type(data) ~= "table" then notify("Configs", "Corrupted config", 3) return end
        for k, v in pairs(data) do
            local setter = Setters[k]
            if setter and not isConfigFlag(k) then pcall(setter, v) end
        end
        notify("Configs", "Loaded " .. slot, 3)
    end

    local function deleteConfig(slot)
        if not (canSave and delfile) then notify("Configs", "Your executor doesn't support delfile", 3) return end
        local path = configPath(slot)
        if isfile(path) then
            pcall(delfile, path)
            notify("Configs", "Deleted " .. slot, 3)
        else
            notify("Configs", slot .. " is already empty", 3)
        end
    end

    local function resetAll()
        for k, v in pairs(Defaults) do
            if not isConfigFlag(k) and Setters[k] then pcall(Setters[k], v) end
        end
        notify("Configs", "Everything reset to default", 3)
    end

    Aurora.Config = {
        Save = saveConfig,
        Load = loadConfig,
        Delete = deleteConfig,
        ResetAll = resetAll,
    }
end

