                        end
                    end
                    if #candidateServers >= 2 then break end
                    task.wait(0.35)
                end
                if #candidateServers > 0 then
                    targetJob = candidateServers[math.random(1, #candidateServers)]
                elseif #fallbackServers > 0 then
                    targetJob = fallbackServers[math.random(1, #fallbackServers)]
                end
            end)
        end

        -- Method 3 (HTTP Public Server API Scan)
        if not targetJob then
            updateTelemetryLog("[Hop] HTTP Public Server Scan...")
            pcall(function()
                local req = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
                local body = nil
                local url = "https://games.roblox.com/v1/games/" .. tostring(game.PlaceId) .. "/servers/Public?sortOrder=Desc&limit=100&excludeFullGames=true"
                if req then
                    local ok, r = pcall(function() return req({ Url = url, Method = "GET" }) end)
                    if ok and r and r.Body then body = r.Body end
                end
                if not body and game.HttpGet then
                    local ok, res = pcall(function() return game:HttpGet(url) end)
                    if ok and res and #res > 0 then body = res end
                end
                if body then
                    local parsed = HttpService:JSONDecode(body)
                    if parsed and parsed.data then
                        local candidateServers = {}
                        local fallbackServers = {}
                        for _, s in ipairs(parsed.data) do
                            if s.id and tostring(s.id) ~= currentJobId then
                                local pl = tonumber(s.playing) or 0
                                local maxPl = tonumber(s.maxPlayers) or 12
