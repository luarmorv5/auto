local function setTabVisual(tab, active)
    tween(tab.Btn, TWEEN_FAST, {BackgroundTransparency = active and 0 or 1})
    tween(tab.Stroke, TWEEN_FAST, {Transparency = active and 0 or 1})
    tween(tab.Icon, TWEEN_FAST, {ImageColor3 = active and THEME.Accent or THEME.TextMuted})
    tween(tab.Title, TWEEN_FAST, {TextColor3 = active and THEME.TextPrimary or THEME.TextMuted})
    tween(tab.Bar, TWEEN_FAST, {Size = UDim2.fromOffset(2, active and 12 or 0)})
end

local function selectTab(tab, force)
    if not tab then return end
    if ActiveTab == tab and not force then return end
    closePopup()
    for _, t in ipairs(Tabs) do
        if t ~= tab and t.Page then
            t.Page.Visible = false
            setTabVisual(t, false)
        end
    end
    ActiveTab = tab
    setTabVisual(tab, true)
    TabPathLabel.Text = "›   " .. ((Aurora and Aurora.I18N and Aurora.I18N(tab.Name)) or tab.Name)
    tab.Page.Position = UDim2.fromOffset(0, 8)
    tab.Page.Visible = true
    local function recalcCanvas(col)
        if not col then return end
        local l = col:FindFirstChildOfClass("UIListLayout")
        if l then
            local h = l.AbsoluteContentSize.Y
            if h and h > 0 then
                col.CanvasSize = UDim2.new(0, 0, 0, h + 40)
            else
                local totalY = 0
                for _, ch in ipairs(col:GetChildren()) do
                    if ch:IsA("GuiObject") and ch.Visible then
                        totalY = totalY + ch.AbsoluteSize.Y + 7
                    end
                end
                if totalY > 0 then
                    col.CanvasSize = UDim2.new(0, 0, 0, totalY + 40)
                end
            end
        end
    end
    recalcCanvas(tab.Left)
    recalcCanvas(tab.Right)
    task.defer(function()
        recalcCanvas(tab.Left)
        recalcCanvas(tab.Right)
    end)
    task.delay(0.06, function()
        recalcCanvas(tab.Left)
        recalcCanvas(tab.Right)
    end)
    if tab.Name == "Player List" and type(_G.AuroraX_RefreshPlayerList) == "function" then
        task.spawn(_G.AuroraX_RefreshPlayerList)
    end
    tween(tab.Page, TWEEN_SLOW, {Position = UDim2.fromOffset(0, 0)})
end

onTheme(function()
    if ActiveTab then ActiveTab.Icon.ImageColor3 = THEME.Accent end
end)

