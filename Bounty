        else
            tween(switch, TWEEN_FAST, props1)
            tween(knob, TWEEN_FAST, props2)
        end
    end

    function obj.Set(selfOrVal, valOrSilent, maybeSilent)
        local v, silent
        if type(selfOrVal) == "table" and selfOrVal == obj then
            v, silent = valOrSilent, maybeSilent
        else
            v, silent = selfOrVal, valOrSilent
        end
        obj.Value = v and true or false
        Flags[flag] = obj.Value
        render(false)
        if opts.Callback and not silent then task.spawn(opts.Callback, obj.Value) end
    end

    function obj.Toggle(self)
        obj.Set(not obj.Value)
    end

    function obj.SetKey(selfOrKc, maybeKc)
        local kc = (type(selfOrKc) == "table" and selfOrKc == obj) and maybeKc or selfOrKc
        obj.Key = kc
        Flags[flag .. "@key"] = kc and kc.Name or ""
