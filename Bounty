        end
        if module and typeof(module) == "table" then
            local tbl16 = { Hit = rawget(module, "Hit"), Target = rawget(module, "Target") }
            local tbl17 = getrawmetatable(module) or {}
            local oldIndex = tbl17.__index

            tbl17.__index = function(arg, arg2)
