local ThemeBinds, ThemeHooks = {}, {}

local function themed(inst, prop, key)
    table.insert(ThemeBinds, {Inst = inst, Prop = prop, Key = key})
    inst[prop] = THEME[key]
    return inst
end

local function onTheme(fn)
    table.insert(ThemeHooks, fn)
    fn(true)
end

local function accentSequence(a, b, c)
    if c then
        return ColorSequence.new({
            ColorSequenceKeypoint.new(0, a),
            ColorSequenceKeypoint.new(0.5, b),
            ColorSequenceKeypoint.new(1, c),
        })
    end
    return ColorSequence.new(a, b)
end

local function setAccent(color, instant)
    THEME.Accent       = color
    THEME.AccentSoft   = color:Lerp(Color3.new(1, 1, 1), 0.42)
    THEME.AccentDark   = color:Lerp(Color3.new(0, 0, 0), 0.47)
    THEME.BorderActive = color:Lerp(THEME.Background, 0.63)
    if THEME.LogoImg then pcall(function() THEME.LogoImg.ImageColor3 = color end) end
    if THEME.MiniLogo then pcall(function() THEME.MiniLogo.ImageColor3 = color end) end
    if THEME.HudLogo then pcall(function() THEME.HudLogo.ImageColor3 = color end) end
    for i = #ThemeBinds, 1, -1 do
        local b = ThemeBinds[i]
        if b.Inst.Parent == nil then
            table.remove(ThemeBinds, i)
        elseif instant then
            b.Inst[b.Prop] = THEME[b.Key]
        else
            tween(b.Inst, TWEEN_FAST, {[b.Prop] = THEME[b.Key]})
        end
    end
    for _, fn in ipairs(ThemeHooks) do pcall(fn, instant) end
end

local function setPresetTheme(presetName)
    local data = THEME.Presets[presetName] or THEME.Presets.Red
    setAccent(data.Color)
    if THEME.LogoImg then
        pcall(function()
            THEME.LogoImg.Image = LOGO_ID
            THEME.LogoImg.ImageColor3 = data.Color
        end)
