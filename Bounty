function Aurora.I18N(key, fallback)
    local lang = (Flags and Flags["Settings/Language"]) or "English"
    local dict = Aurora.Translations[lang]
    if dict and dict[key] then return dict[key] end
    return fallback or key
end

function Aurora.UpdateLanguage(lang)
    if Flags then Flags["Settings/Language"] = lang end
    if Aurora.Localized then
        for i = #Aurora.Localized, 1, -1 do
            local item = Aurora.Localized[i]
            if item.Inst and item.Inst.Parent then
                local t = Aurora.I18N(item.Key)
                if t then
                    if item.Upper then t = string.upper(t) end
                    pcall(function() item.Inst.Text = t end)
                end
            else
                table.remove(Aurora.Localized, i)
            end
        end
    end
    if ActiveTab and TabPathLabel then
        TabPathLabel.Text = "›   " .. ((Aurora and Aurora.I18N and Aurora.I18N(ActiveTab.Name)) or ActiveTab.Name)
    end
end

