    local function to(Pos)
        if not isCurrentSession() then return end
        if not (bountyRunning or isServerHopping or getgenv().IsServerHopping) then return end
        if typeof(Pos) ~= "CFrame" then return end

        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return end

        if cachedPartTele and cachedPartTele.Parent ~= char then
            cleanupAutoBountyTweenAndPart()
        end

        if hrp.Position.Y < 5 then
            hrp.CFrame = CFrame.new(hrp.Position.X, 35, hrp.Position.Z)
            hrp.AssemblyLinearVelocity = Vector3.zero
        end

        local targetPos = Pos
        if targetPos.Position.Y < 18 then
            targetPos = CFrame.new(targetPos.Position.X, 18, targetPos.Position.Z) * targetPos.Rotation
        end

        local distance = (targetPos.Position - hrp.Position).Magnitude

        startAutoBountyNoclip()

        local farSpeed = math.clamp(tonumber(Flags["AutoBounty/FarSpeed"]) or 160, 100, 350)
        local nearSpeed = math.clamp(tonumber(Flags["AutoBounty/NearSpeed"]) or 350, 100, 350)
        local speed = nearSpeed

        local curTarg = getgenv().targ
        if curTarg and curTarg.Character then
            local tHrp = curTarg.Character:FindFirstChild("HumanoidRootPart")
            if tHrp then
                local distToEnemy = (tHrp.Position - hrp.Position).Magnitude
                if distToEnemy <= 300 then
                    getgenv().AutoBountyReachedTarget = true
                end
                if getgenv().AutoBountyReachedTarget then
                    speed = nearSpeed
                else
                    speed = farSpeed
                end
            else
                speed = nearSpeed
            end
        else
            speed = nearSpeed
        end

        -- Bloqueo cuerpo a cuerpo (rango <= 15 studs): fijacion directa sin sobrecargar tweens (Project Spooky)
        if distance <= 15 then
            if activeBountyTween then
                pcall(function() activeBountyTween:Cancel() end)
                activeBountyTween = nil
                activeBountyTweenSpeed = nil
            end
            hrp.CFrame = targetPos
            if cachedPartTele and cachedPartTele.Parent == char then
                cachedPartTele.CFrame = targetPos
            end
            currentAutoBountyTargetCF = targetPos
            return
        end

        -- Suavizado de trayectoria: si el tween activo apunta a la misma zona (deriva < 3.5 studs), continuar progresion (Project Spooky)
        if activeBountyTween and activeBountyTween.PlaybackState == Enum.PlaybackState.Playing and currentAutoBountyTargetCF then
            local drift = (targetPos.Position - currentAutoBountyTargetCF.Position).Magnitude
            if drift < 3.5 then
                return
            end
        end

        local existingHold = hrp:FindFirstChild("Hold")
        if existingHold then pcall(function() existingHold:Destroy() end) end

        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        if hum.Sit then hum.Sit = false end

        -- PartTele creation and CFrame synchronizer
        local partTele = cachedPartTele
        if not (partTele and partTele.Parent == char and partTele:IsA("BasePart")) then
            local stalePart = char:FindFirstChild("PartTele")
            if stalePart then pcall(function() stalePart:Destroy() end) end
            if partTeleConnection then pcall(function() partTeleConnection:Disconnect() end); partTeleConnection = nil end
            if partTeleHeartbeatConn then pcall(function() partTeleHeartbeatConn:Disconnect() end); partTeleHeartbeatConn = nil end

            partTele = Instance.new("Part")
            partTele.Size = Vector3.new(10, 1, 10)
            partTele.Name = "PartTele"
            partTele.Anchored = true
            partTele.Transparency = 1
            partTele.CanCollide = false
            partTele.CFrame = hrp.CFrame
            partTele.Parent = char

            partTeleConnection = sessionConnect(partTele:GetPropertyChangedSignal("CFrame"), function()
                if (bountyRunning or isServerHopping or getgenv().IsServerHopping) and LocalPlayer.Character == char and char:FindFirstChild("HumanoidRootPart") then
                    char.HumanoidRootPart.CFrame = partTele.CFrame
                    char.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
                end
            end)

            if not partTeleHeartbeatConn then
                partTeleHeartbeatConn = sessionConnect(RunService.Heartbeat, function()
                    if not (bountyRunning or isServerHopping or getgenv().IsServerHopping) then
                        if partTeleHeartbeatConn then partTeleHeartbeatConn:Disconnect(); partTeleHeartbeatConn = nil end
                        return
                    end
                    local c = LocalPlayer.Character
                    if c and (isServerHopping or getgenv().IsServerHopping or getgenv().HealingInSky) and cachedPartTele and cachedPartTele.Parent == c then
                        local root = c:FindFirstChild("HumanoidRootPart")
                        if root then
                            root.CFrame = cachedPartTele.CFrame
                            root.AssemblyLinearVelocity = Vector3.zero
                        end
                    end
                end)
            end

            cachedPartTele = partTele
        end

        partTele.Anchored = true
        partTele.CanCollide = false
        if (partTele.Position - hrp.Position).Magnitude > 40 then
            partTele.CFrame = hrp.CFrame
        end

        lastTrackAt = os.clock()
        local duration = math.max(distance / speed, 0.05)

        if activeBountyTween then
            pcall(function() activeBountyTween:Cancel() end)
            activeBountyTween = nil
        end

        currentAutoBountyTargetCF = targetPos
        activeBountyTweenSpeed = speed
        activeBountyTween = TweenService:Create(
            partTele,
            TweenInfo.new(duration, Enum.EasingStyle.Linear),
            { CFrame = targetPos }
        )
        activeBountyTween:Play()
    end

