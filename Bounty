                                                end
                                            end
                                            -- Target 5 to 10 players: plenty of bounty targets, not full, not empty
                                            if count and count >= 5 and count <= 10 then
                                                table.insert(candidateJobs, strJob)
                                            elseif count and count >= 4 and count <= 11 then
                                                table.insert(fallbackJobs, strJob)
                                            elseif not count then
                                                table.insert(fallbackJobs, strJob)
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                    if #candidateJobs > 0 then break end
                end
                if #candidateJobs > 0 then
                    targetJob = candidateJobs[math.random(1, #candidateJobs)]
                elseif #fallbackJobs > 0 then
                    targetJob = fallbackJobs[math.random(1, #fallbackJobs)]
                end

                sbGui.Frame.Position = oldPos
                sbGui.Frame.Visible = false
                sbGui.Enabled = false
            end)
        end

        -- Method 2 (Spooky Direct Remote Scan: ReplicatedStorage.__ServerBrowser)
        if not targetJob and sbRemote then
            updateTelemetryLog("[Hop] Direct Remote Scan (__ServerBrowser)...")
            pcall(function()
                local candidateServers = {}
                local fallbackServers = {}
                for page = 1, 3 do
                    local s, servers = pcall(function()
                        return sbRemote:InvokeServer(page)
                    end)
                    if s and type(servers) == "table" then
                        for k, v in pairs(servers) do
                            local strK = tostring(k)
                            if strK ~= currentJobId and strK:find("-", 1, true) and type(v) == "table" then
                                local cnt = tonumber(v.Count) or 0
                                local regionMatch = true
                                if targetRegion and targetRegion ~= "All" and v.Region then
                                    if not string.find(string.lower(tostring(v.Region)), string.lower(targetRegion)) then
                                        regionMatch = false
                                    end
                                end
                                -- Sweet spot: 5 to 10 players (never 0, 1, or 2!)
                                if cnt >= 5 and cnt <= 10 and (regionMatch or page > 2) then
                                    table.insert(candidateServers, strK)
                                elseif cnt >= 4 and cnt <= 11 and (regionMatch or page > 2) then
                                    table.insert(fallbackServers, strK)
                                end
