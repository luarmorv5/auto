                end
            end
        end)

        -- 5. SafeZone / Arena message detector (Lag-optimized, checks Notifications only)
        task.spawn(function()
            while isBountyCurrent() and task.wait(0.5) do
                local curTarg = getgenv().targ
                if curTarg then
                    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
                    local notifs = pGui and (pGui:FindFirstChild("Notifications") or pGui:FindFirstChild("CombatFlags"))
                    if notifs then
                        for _, descendant in ipairs(notifs:GetChildren()) do
                            if descendant:IsA("TextLabel") and descendant.Visible and descendant.Text ~= "" then
                                local str = descendant.Text:lower()
                                if str:find("cannot attack") and str:find("safe") then
                                    safeZoneTempBlock[curTarg.Name] = os.clock() + 20
                                    updateTelemetryLog(string.format("[Hunt] %s in Safe Zone -> skipped (20s)", curTarg.DisplayName or curTarg.Name))
                                    SkipPlayer(false)
                                    break
                                elseif (str:find("arena") or str:find("colosseum")) and (str:find("cannot") or str:find("can't") or str:find("friendly")) then
                                    safeZoneTempBlock[curTarg.Name] = os.clock() + 20
                                    updateTelemetryLog(string.format("[Hunt] %s in Arena -> skipped (20s)", curTarg.DisplayName or curTarg.Name))
                                    SkipPlayer(false)
                                    break
                                end
                            end
                        end
                    end
                end
            end
        end)

        -- 5. Bounty Earned Tracker Loop
        task.spawn(function()
            local initialBounty = nil
            while isBountyCurrent() and task.wait(1) do
                pcall(function()
                    local ls = LocalPlayer:FindFirstChild("leaderstats")
                    local bStat = ls and (ls:FindFirstChild("Bounty/Honor") or ls:FindFirstChild("Bounty") or ls:FindFirstChild("Honor"))
                    local current = bStat and tonumber(bStat.Value) or 0
                    if not initialBounty then initialBounty = current end
                    local earned = math.max(0, current - initialBounty)
                    if setEarnedText then setEarnedText(string.format("%s", tostring(earned))) end
                    if setHomeBountyEarned then setHomeBountyEarned(tostring(earned)) end
                end)
            end
        end)

        -- Initial target lock
        task.defer(function()
            local initTarg = findTarget()
            if initTarg then selectTarget(initTarg) end
        end)
    end

    local toggleKitAutoBounty = nil

    toggleAutoBounty = function(on)
        if on then
            if bountyRunning and not Aurora.Booleans.KitBountyRunning then return end
            if Aurora.Booleans.KitBountyRunning and toggleKitAutoBounty then
                toggleKitAutoBounty(false)
            end
            bountyRunning = true
            Aurora.Booleans.BountyRunning = true
            Aurora.Booleans.KitBountyRunning = false
            Aurora.Booleans.HealingInSky = false
            Aurora.Booleans.CancelHealing = false
            Aurora.Booleans.AutoBountyReachedTarget = false
            getgenv().AutoBountyRunning       = true
            getgenv().HealingInSky            = false
            getgenv().CancelHealing           = false
            getgenv().AutoBountyReachedTarget = false
            getgenv().checked                 = {}
            getgenv().targ                    = nil
            getgenv().weapon                  = "Melee"

            Aurora.Strings.HuntStatus = "Active & Hunting"
            if setStatusText then setStatusText("Hunting Targets...") end
            if setHomeBountyStatus then setHomeBountyStatus("Active & Hunting") end
            if masterBountyToggleObj and masterBountyToggleObj.Value ~= true then masterBountyToggleObj.Set(true, true) end
            updateTelemetryLog("[Hunt] Auto Bounty engine started!")
            notify("Auto Bounty", "Auto Bounty Activated! By Darling", 3)

            startBountyLoops()
        else
            bountyRunning = false
            Aurora.Booleans.BountyRunning = false
            getgenv().AutoBountyRunning   = false
            disconnectBounty()
            cleanupAutoBountyTweenAndPart()
            stopAutoBountyNoclip()

            Aurora.Strings.HuntStatus = "Inactive (Disabled)"
            Aurora.Strings.CurrentTargetName = "None"
            Aurora.Strings.CurrentTargetBounty = "-"
            Aurora.Strings.CurrentTargetDistance = "-"
            if setStatusText then setStatusText("Inactive / Stopped") end
            if setHomeBountyStatus then setHomeBountyStatus("Inactive (Disabled)") end
            if masterBountyToggleObj and masterBountyToggleObj.Value ~= false then masterBountyToggleObj.Set(false, true) end
            if setTargetNameText then setTargetNameText("None") end
            if setTargetBountyText then setTargetBountyText("-") end
            if setDistanceText then setDistanceText("-") end
            updateTelemetryLog("[Hunt] Auto Bounty stopped.")
            notify("Auto Bounty", "Auto Bounty Stopped!", 2)
        end
    end
    Aurora.ToggleAutoBounty = toggleAutoBounty

    toggleKitAutoBounty = function(on)
        toggleAutoBounty(on)
    end
    Aurora.ToggleKitAutoBounty = toggleKitAutoBounty

    do
        local _genv = (type(getgenv) == "function" and getgenv()) or _G
        if _genv.AuroraX then
            _genv.AuroraX.ToggleAutoBounty = toggleAutoBounty
            _genv.AuroraX.ToggleKitAutoBounty = toggleKitAutoBounty
        end
        _genv.ToggleAutoBounty = toggleAutoBounty
        _genv.ToggleKitAutoBounty = toggleKitAutoBounty
    end

    -- Auto Select Team on Execution (Pirates or Marines)
    task.spawn(function()
        task.wait(0.6)
        local chosenTeam = Flags["AutoBounty/AutoTeam"] or "Pirates"
        if getPlayerTeam(LocalPlayer) ~= chosenTeam then
            if joinFaction then joinFaction(chosenTeam) end
            if updateTelemetryLog then
                updateTelemetryLog(string.format("[Team] Deployed as %s!", chosenTeam))
            end
        end
    end)
end

