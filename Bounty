local function applySavedPosition(guiObj, keyName)
    if not guiObj then return end
    keyName = keyName or guiObj.Name
    local layout = loadStoredHUDLayout()
    local data = layout and layout[keyName]
    if data then
        pcall(function()
            guiObj.Position = UDim2.new(data.ScaleX or 0, data.OffsetX or 0, data.ScaleY or 0, data.OffsetY or 0)
            if data.SizeScale then
                local s = guiObj:FindFirstChildOfClass("UIScale")
                if not s then s = Instance.new("UIScale", guiObj) end
                s.Scale = data.SizeScale
            end
        end)
    end
end

