    end)
    btn.MouseLeave:Connect(function()
        tween(st, TWEEN_FAST, {Color = THEME.Border})
        tween(btn, TWEEN_FAST, {TextColor3 = THEME.TextPrimary})
        if ic then tween(ic, TWEEN_FAST, {ImageColor3 = THEME.TextMuted}) end
    end)

    local clicking = false
    local function doClick()
        if clicking then return end
        clicking = true
        sc.Scale = 0.96
        tween(sc, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1})
        task.delay(0.2, function() clicking = false end)
        if opts.Callback then task.spawn(opts.Callback) end
    end
    btn.Activated:Connect(doClick)
    btn.MouseButton1Click:Connect(doClick)

    local closure = {
        Instance = btn,
        Button = btn,
        Row = row,
        SetText = function(self, newText)
            btn.Text = tostring(newText)
        end,
        SetCallback = function(self, newCb)
            opts.Callback = newCb
        end,
        Trigger = function(self)
            doClick()
        end,
    }
    table.insert(Aurora.UI.Elements, closure)
    return closure
end

