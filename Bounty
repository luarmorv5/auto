-- TAB 2: AUTO BOUNTY MODULE
-- =============================================================================
local function initAutoBounty()
    -- Helpers
    local function logEvent(msg)
        print("[Aurora X Auto Bounty] " .. tostring(msg))
    end

    -- State Tables
    getgenv().AutoBountyRunning       = false
    getgenv().HealingInSky            = false
    getgenv().CancelHealing           = false
    getgenv().AutoBountyReachedTarget = false
    getgenv().safeZoneWaitRetries     = 0
    getgenv().checked                 = getgenv().checked or {}
    getgenv().targ                    = nil

    local bountyEpoch   = 0
    local bountyConnections = {}
    local totalDefeated = 0
    local startingBounty = 0
    local cachedPartTele = nil
    local partTeleConnection = nil
    local partTeleHeartbeatConn = nil
    local activeBountyTween = nil
    local activeBountyTweenSpeed = nil
    local currentAutoBountyTargetCF = nil
    local lastTrackAt = os.clock()
    local bountyCollision = setmetatable({}, {__mode="k"})

    -- Wire to Shared UI Setters & Telemetry
    updateTelemetryLog = function(msg)
        if setLogMessage then setLogMessage(msg) end
        logEvent(msg)
    end

    local function isBountyCurrent()
        return isCurrentSession() and (bountyRunning == true)
    end

    local function bountyConnect(signal, callback)
        if not isBountyCurrent() then return nil end
        local conn = signal:Connect(function(...)
            if isBountyCurrent() then callback(...) end
        end)
        table.insert(bountyConnections, conn)
        return conn
    end

    local function disconnectBounty()
        bountyEpoch = bountyEpoch + 1
        if partTeleHeartbeatConn then
            pcall(function() partTeleHeartbeatConn:Disconnect() end)
            partTeleHeartbeatConn = nil
        end
        if partTeleConnection then
            pcall(function() partTeleConnection:Disconnect() end)
            partTeleConnection = nil
        end
        for _, conn in ipairs(bountyConnections) do
            pcall(function() conn:Disconnect() end)
        end
        table.clear(bountyConnections)
        autoBountyNoclipConn = nil
    end

    -- Helper Utilities from message(28).txt
    local function hasValue(array, targetVal)
        if not array then return false end
        for _, v in ipairs(array) do
            if v == targetVal then return true end
        end
        return false
    end

    local function getPlayerLevel(p)
        if not p then return 0 end
        local d = p:FindFirstChild("Data")
        if d and d:FindFirstChild("Level") and d.Level:IsA("ValueBase") then
            return tonumber(d.Level.Value) or 0
        end
        local ls = p:FindFirstChild("leaderstats")
        if ls and ls:FindFirstChild("Level") and ls.Level:IsA("ValueBase") then
            return tonumber(ls.Level.Value) or 0
        end
        if p:GetAttribute("Level") then
            return tonumber(p:GetAttribute("Level")) or 0
        end
        if p.Character and p.Character:GetAttribute("Level") then
            return tonumber(p.Character:GetAttribute("Level")) or 0
        end
        return 0
    end

    local safeZoneTempBlock = {}

    local function AX_ReadPvPState(target)
        if not target then return false end
        local ok, pvpOn = pcall(function()
            if target:IsA("Player") and target:GetAttribute("PvpDisabled") == true then
                return false
            end
            local char = target.Character or (target:IsA("Model") and target)
            if char then
                if char:FindFirstChildOfClass("ForceField") then return false end
                if char:GetAttribute("PvpDisabled") == true then return false end
            end
            return true
        end)
        return ok and pvpOn == true
    end

    local function AX_InSafeZone(target)
        if not target then return false end
        local ok, inZone = pcall(function()
            local char = target.Character or (target:IsA("Model") and target)
            if not char then return false end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return false end

            -- ForceField protects new spawns / safe zone players
            if char:FindFirstChildOfClass("ForceField") then return true end

            -- Temporary safe zone cooldown from combat notifications
            local blockedUntil = safeZoneTempBlock[target.Name]
            if blockedUntil then
                if os.clock() < blockedUntil then
                    return true
                else
                    safeZoneTempBlock[target.Name] = nil
                end
            end

            -- Direct Blox Fruits safe zone attributes
            if target:IsA("Player") and target:GetAttribute("SafeZone") == true then return true end
            if char:GetAttribute("SafeZone") == true or char:GetAttribute("InSafeZone") == true then return true end
            if hrp:GetAttribute("SafeZone") == true or hrp:GetAttribute("InSafeZone") == true then return true end

            -- SafeZone folder check in _WorldOrigin
            local wo = workspace:FindFirstChild("_WorldOrigin")
            local safeZones = wo and wo:FindFirstChild("SafeZones")
            if safeZones then
                for _, zone in pairs(safeZones:GetChildren()) do
                    if zone:IsA("BasePart") then
                        local mesh = zone:FindFirstChild("Mesh")
                        local radius = 350
                        if mesh and mesh:IsA("SpecialMesh") then
                            radius = (zone.Size.X * mesh.Scale.X) / 2
                        else
                            radius = math.min(zone.Size.X, zone.Size.Z) / 2
                        end
                        if radius > 500 or radius <= 0 then radius = 350 end
                        if (zone.Position - hrp.Position).Magnitude <= radius then
                            return true
                        end
                    end
                end
            end

            return false
        end)
        return ok and inZone == true
    end

    local function isAllyWithMe(targetplayer)
        if not targetplayer or targetplayer == LocalPlayer then return false end
        local ok, res = pcall(function()
            local myGui = LocalPlayer:FindFirstChild("PlayerGui")
            local main = myGui and myGui:FindFirstChild("Main")
            local allies = main and main:FindFirstChild("Allies")
            local container = allies and allies:FindFirstChild("Container")
            local alliesFolder = container and container:FindFirstChild("Allies")
            local scrolling = alliesFolder and alliesFolder:FindFirstChild("ScrollingFrame")
            if scrolling then
                local pFrame = scrolling:FindFirstChild(targetplayer.Name)
                if pFrame then
                    for _, d in ipairs(pFrame:GetDescendants()) do
                        if d:IsA("TextLabel") and string.find(string.lower(d.Text), "leave") then
                            return true
                        end
                    end
                end
            end
            return false
        end)
        return ok and res == true
    end

    local function getPlayerTeam(p)
        if not p then return nil end
        local ok, val = pcall(function() return p.Data.Team.Value end)
        if ok and val and val ~= "" then return val end
        local t = p.Team
        return t and t.Name or nil
    end

    joinFaction = function(teamName)
        local targetTeam = (teamName == "Marines" or teamName == "Pirates") and teamName or "Pirates"
        pcall(function()
            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
            local commF = remotes and remotes:FindFirstChild("CommF_")
            if commF then
                commF:InvokeServer("SetTeam", targetTeam)
            end
        end)
    end

    local function isEnemy(targetplayer)
        if not targetplayer or targetplayer == LocalPlayer then return false end
        local myTeam = getPlayerTeam(LocalPlayer)
        local targetTeam = getPlayerTeam(targetplayer)
        if myTeam and targetTeam then
            if myTeam == "Marines" and targetTeam == "Marines" then return false end
            if myTeam == "Marines" and targetTeam == "Pirates" then return true end
            if myTeam == "Pirates" and targetTeam == "Marines" then return true end
            if myTeam == "Pirates" and targetTeam == "Pirates" then return not isAllyWithMe(targetplayer) end
        end
        return true
    end

    local function isLocalPvpDisabled()
        local ok, dis = pcall(function()
            if LocalPlayer:GetAttribute("PvpDisabled") == true then return true end
            local main = LocalPlayer.PlayerGui:FindFirstChild("Main")
            if not main then return false end
            local bList = main:FindFirstChild("BottomHUDList")
            if bList and bList:FindFirstChild("PvpDisabled") and bList.PvpDisabled.Visible == true then
                return true
            end
            if main:FindFirstChild("PvpDisabled") and main.PvpDisabled.Visible == true then
                return true
            end
            return false
        end)
        return ok and dis
    end

    -- Transformation detection
    local function isBeastFruit(tool)
        if not tool then return false end
        local n = string.lower(tool.Name):gsub("[^%w]", "")
        local beastList = { "buddha", "kitsune", "dragon", "leopard", "mammoth", "trex", "venom", "phoenix", "falcon" }
        for _, b in ipairs(beastList) do
            if string.find(n, b) then return true end
        end
        return false
    end

    local function isFruitTransformed()
        local ok, r = pcall(function()
            local char = LocalPlayer.Character
            if not char then return false end
            local curTool = char:FindFirstChildOfClass("Tool")
            if not isBeastFruit(curTool) then
                return false -- Frutas normales (Dough, Portal, Ice, etc.) siempre pueden usar V sin restricción!
            end
            return char:GetAttribute("Transformed") == true
                or char:FindFirstChild("Transformation") ~= nil
                or char:FindFirstChild("KitsuneMode") ~= nil
                or char:FindFirstChild("DragonMode") ~= nil
                or char:FindFirstChild("BuddhaForm") ~= nil
        end)
        return ok and r
    end

    local function getToolCategory(tool)
        if not tool then return "Melee" end
        local name = string.lower(tool.Name)
        local gunNames = { "guitar", "rifle", "cannon", "gun", "slingshot", "kabucha", "serpent bow", "bow" }
        for _, g in ipairs(gunNames) do
            if string.find(name, g) then return "Gun" end
        end
        local meleeNames = { "claw", "godhuman", "superhuman", "talon", "step", "karate", "breath", "kung fu", "combat", "fist", "sanguine" }
        for _, m in ipairs(meleeNames) do
            if string.find(name, m) then return "Melee" end
        end
        if string.find(name, "fruit") or string.find(name, "-") then return "Fruit" end
        return "Sword"
    end

    local function isToolMatchingType(tool, toolType)
        if not tool or not tool:IsA("Tool") then return false end
        local tip = tool.ToolTip
        if toolType == "Melee" then
            return tip == "Melee" or tip == "Fighting"
        elseif toolType == "Blox Fruit" then
            return tip == "Blox Fruit"
        elseif toolType == "Sword" then
            return tip == "Sword"
        elseif toolType == "Gun" then
            return tip == "Gun"
        else
            return tip == toolType
        end
    end

    local function equip(toolType)
        local char = LocalPlayer.Character
        if not char then return false end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return false end

        local curTool = char:FindFirstChildOfClass("Tool")
        if curTool and isToolMatchingType(curTool, toolType) then
            return true
        end

        local bp = LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:FindFirstChild("Backpack")
        if not bp then return false end

        for _, item in ipairs(bp:GetChildren()) do
            if isToolMatchingType(item, toolType) then
                hum:EquipTool(item)
                return true
            end
        end

        -- Fallback: if preferred weapon type is missing, equip first available combat weapon
        if not curTool then
