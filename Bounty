                        end
                    end

                    local myChar = LocalPlayer.Character
                    if curTarg and curTarg.Character and myChar then
                        local targetHRP = curTarg.Character:FindFirstChild("HumanoidRootPart")
                        local myHRP = myChar:FindFirstChild("HumanoidRootPart")
                        local myHum = myChar:FindFirstChildOfClass("Humanoid")
                        local targetHum = curTarg.Character:FindFirstChildOfClass("Humanoid")

                        if targetHRP and myHRP and myHum and targetHum then
                            if targetHum.Health <= 0 then
                                SkipPlayer(true)
                            else
                                local currentPos = targetHRP.Position
                                local dist = (currentPos - myHRP.Position).Magnitude
                                local isMoving = (b and (currentPos - b).Magnitude > 1) or false
                                b = currentPos

                                local nowTime = tick()
                                if nowTime - lastDistUpdate >= 0.25 then
                                    lastDistUpdate = nowTime
                                    if setDistanceText then setDistanceText(string.format("%dm", math.floor(dist))) end
                                    if Aurora.UI.Setters.KitDistance then Aurora.UI.Setters.KitDistance(string.format("%dm", math.floor(dist))) end
                                end

                                local gotoPos
                                local targetY = math.max(targetHRP.Position.Y, 18)
                                if dist < 40 then
                                    if isMoving then
                                        gotoPos = targetHRP.CFrame * CFrame.new(0, 5, -9)
                                    else
                                        gotoPos = targetHRP.CFrame * CFrame.new(0, 5, 7)
                                    end
                                    gotoPos = CFrame.lookAt(gotoPos.Position, targetHRP.Position)
                                elseif dist < 120 then
                                    local p120 = targetHRP.CFrame * CFrame.new(0, 5, -17)
                                    gotoPos = CFrame.lookAt(p120.Position, targetHRP.Position)
                                else
                                    local transitY = math.max(targetY + 25, 75)
                                    gotoPos = CFrame.new(targetHRP.Position.X, transitY, targetHRP.Position.Z)
                                end
                                if gotoPos.Position.Y < 18 then
                                    gotoPos = CFrame.new(gotoPos.Position.X, 18, gotoPos.Position.Z) * gotoPos.Rotation
                                end

                                -- Healing in Sky logic (Default flee: 3000 HP, return: 5000 HP - fully user-configurable)
                                local fleeHP = tonumber(Flags["AutoBounty/HealHP"]) or 3000
                                local returnHP = tonumber(Flags["AutoBounty/ReturnHP"]) or 5000
                                local healThreshold = (fleeHP <= 100) and (fleeHP * myHum.MaxHealth / 100) or fleeHP
                                local returnThreshold = (returnHP <= 100) and (returnHP * myHum.MaxHealth / 100) or returnHP

                                if myHum.Health >= returnThreshold then
                                    getgenv().CancelHealing = false
                                    if getgenv().HealingInSky then
                                        getgenv().HealingInSky = false
                                        cleanupAutoBountyTweenAndPart()
                                    end
                                end

                                if not getgenv().HealingInSky then
                                    if myHum.Health < healThreshold and not getgenv().CancelHealing then
                                        getgenv().HealingInSky = true
                                        updateTelemetryLog(string.format("[Heal] HP below %d! Escaping to sky to heal...", math.floor(healThreshold)))
                                    end
                                else
                                    if getgenv().CancelHealing or myHum.Health >= returnThreshold then
                                        getgenv().HealingInSky = false
                                        cleanupAutoBountyTweenAndPart()
                                        updateTelemetryLog(string.format("[Heal] HP recovered to %d! Resuming hunt.", math.floor(returnThreshold)))
                                    end
                                end

                                if getgenv().HealingInSky and not getgenv().CancelHealing then
                                    local skyTargetCF = targetHRP.CFrame * CFrame.new(0, 1500, 0)
