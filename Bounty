            obj.SetKey(ok and kc or nil)
        else
            obj.SetKey(nil)
        end
    end)

    obj.Value = opts.Default or false
    render(true)
    obj.SetKey(opts.Key)
    if opts.Default and opts.Callback then
        task.spawn(opts.Callback, true)
    end
    table.insert(KeyToggles, obj)
    table.insert(Aurora.UI.Elements, obj)
    return obj
end

-- Slider -----------------------------------------------------------------------
-- opts: Min, Max, Default, Decimals, Suffix, Callback, Flag
function Aurora.UI.CreateSlider(card, name, opts)
    opts = opts or {}
    local min, max = opts.Min or 0, opts.Max or 100
    local decimals = opts.Decimals or 0
    local suffix = opts.Suffix or ""
    local default = opts.Default or min
    local flag = flagOf(card, name, opts)
    local row = newRow(card, name, 28)

    newText(row, name, 10, THEME.TextPrimary, Enum.Font.GothamMedium, {
        Size = UDim2.new(1, -50, 0, 13), TextTruncate = Enum.TextTruncate.AtEnd,
    })
    local valueLbl = newText(row, "", 9, THEME.TextMuted, Enum.Font.GothamMedium, {
        AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0),
        Size = UDim2.fromOffset(50, 13), TextXAlignment = Enum.TextXAlignment.Right,
    })

    local track = create("Frame", {
        Position = UDim2.new(0, 0, 0, 20),
        Size = UDim2.new(1, 0, 0, 4),
        BackgroundColor3 = THEME.ToggleOff,
        BorderSizePixel = 0,
        Parent = row,
    })
    addRound(track)
    local fill = create("Frame", {
        Size = UDim2.fromScale(0, 1),
        BorderSizePixel = 0,
        Parent = track,
    })
    addRound(fill)
    themed(fill, "BackgroundColor3", "Accent")
    local knob = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0, 0.5),
        Size = UDim2.fromOffset(10, 10),
        BackgroundColor3 = THEME.KnobOn,
        BorderSizePixel = 0,
        Parent = track,
    })
    addRound(knob)
    local hit = create("TextButton", {
        Position = UDim2.new(0, 0, 0, 14),
        Size = UDim2.new(1, 0, 0, 16),
        BackgroundTransparency = 1,
        Text = "",
        Parent = row,
    })

    local obj = {
        Instance = track,
        Value = default,
    }
    local mult = 10 ^ decimals

    local function fmt(v)
        if decimals > 0 then return string.format("%." .. decimals .. "f", v) .. suffix end
        return tostring(math.floor(v + 0.5)) .. suffix
    end

    function obj.Set(selfOrVal, valOrSilent, maybeSilent)
        local v, silent
        if type(selfOrVal) == "table" and selfOrVal == obj then
            v, silent = valOrSilent, maybeSilent
        else
            v, silent = selfOrVal, valOrSilent
        end
        v = math.clamp(tonumber(v) or default, min, max)
        v = math.floor(v * mult + 0.5) / mult
        obj.Value = v
        Flags[flag] = v
        local pct = (max - min) > 0 and (v - min) / (max - min) or 0
        tween(fill, Aurora.Tweens.Slide, {Size = UDim2.fromScale(pct, 1)})
        tween(knob, Aurora.Tweens.Slide, {Position = UDim2.fromScale(pct, 0.5)})
        valueLbl.Text = fmt(v)
        if opts.Callback and not silent then task.spawn(opts.Callback, v) end
    end

    function obj.GetValue(self)
        return obj.Value
    end

    local dragging = false
    local function update(x)
        local pct = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        local v = min + (max - min) * pct
        if math.abs(v - obj.Value) >= (1 / mult) * 0.5 or pct == 0 or pct == 1 then
            obj.Set(v)
        end
    end

    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            tween(knob, TWEEN_FAST, {Size = UDim2.fromOffset(12, 12)})
            update(input.Position.X)
        end
    end)
    connect(UserInputService.InputChanged, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input.Position.X)
        end
    end)
    connect(UserInputService.InputEnded, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            dragging = false
            tween(knob, TWEEN_FAST, {Size = UDim2.fromOffset(10, 10)})
        end
    end)

    register(flag, default, function(v) obj.Set(v) end)
    obj.Set(default, true)
    table.insert(Aurora.UI.Elements, obj)
    return obj
end

