                        end
                        if #candidateServers > 0 then
                            targetJob = candidateServers[math.random(1, #candidateServers)]
                        elseif #fallbackServers > 0 then
                            targetJob = fallbackServers[math.random(1, #fallbackServers)]
                        end
                    end
                end
            end)
        end

        -- Teleport Execution
        if targetJob then
            updateTelemetryLog(string.format("[Hop] Teleporting to %s...", targetJob:sub(1, 8)))
            if sbRemote then
                pcall(function() sbRemote:InvokeServer("teleport", targetJob) end)
            end
            task.wait(0.2)
            pcall(function()
                TeleportService:TeleportToPlaceInstance(game.PlaceId, targetJob, LocalPlayer)
            end)
            task.wait(2)
            isServerHopping = false
            getgenv().IsServerHopping = false
            return true
        end

        -- Method 4 (Universal Direct Teleport Fallback)
        updateTelemetryLog("[Hop] Fast Teleport Fallback...")
        pcall(function()
            TeleportService:Teleport(game.PlaceId, LocalPlayer)
        end)
        task.wait(2)
        isServerHopping = false
        getgenv().IsServerHopping = false
        return false
    end
