applyFilter = function()
    local q = string.lower(SearchInput.Text)
    local tabHas = {}
    for _, card in ipairs(AllCards) do
        local titleMatch = q ~= "" and string.find(string.lower(card.Title), q, 1, true) ~= nil
        local any = false
        for _, r in ipairs(card.Rows) do
            local match = (q == "") or titleMatch or (string.find(r.Name, q, 1, true) ~= nil)
            if match then any = true end
            r.Frame.Visible = match and not card.Collapsed
        end
        card.Frame.Visible = (q == "") or any
        if any then tabHas[card.Tab] = true end
    end
    for _, tab in ipairs(Tabs) do
        local dim = (q ~= "") and not tabHas[tab]
        tween(tab.Title, TWEEN_FAST, {TextTransparency = dim and 0.6 or 0})
        tween(tab.Icon, TWEEN_FAST, {ImageTransparency = dim and 0.6 or 0})
    end
end
