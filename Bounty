function Aurora.UI.CreateLabel(card, text, value)
    local row = newRow(card, text, 15)
    newText(row, text, 9, THEME.TextMuted, Enum.Font.GothamMedium, {
        Size = UDim2.new(0.5, 0, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd,
    })
    local val = newText(row, value or "", 9, THEME.TextPrimary, Enum.Font.GothamMedium, {
        AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0),
        Size = UDim2.new(0.6, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Right,
        TextTruncate = Enum.TextTruncate.AtEnd,
    })
    local setter = setmetatable({
        Instance = val,
        Text = tostring(value or ""),
        Set = function(self, newValue)
            val.Text = tostring(newValue)
            self.Text = val.Text
        end,
    }, {
        __call = function(self, newValue)
            val.Text = tostring(newValue)
            self.Text = val.Text
        end,
        __index = function(self, k)
            if k == "Text" then return val.Text end
            return rawget(self, k) or val[k]
        end,
        __newindex = function(self, k, v)
            if k == "Text" then
                val.Text = tostring(v)
            else
                rawset(self, k, v)
            end
        end,
    })
    table.insert(Aurora.UI.Elements, setter)
    return setter
end

