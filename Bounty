    -- TARGET FINDER & MANAGEMENT (From auto bounty(1).lua lines 2296-2359)
    -- =========================================================================
    local skippedPlayers = setmetatable({}, {__mode="k"})

    local function findTarget()
        local myChar = LocalPlayer.Character
        local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myHrp then return nil, 0 end
        local myPos = myHrp.Position

        local bestTarget = nil
        local bestDist = math.huge
        local candidateCount = 0

        local checkedList = getgenv().checked or {}

        for _, pl in ipairs(Players:GetPlayers()) do
            if pl ~= LocalPlayer and isEnemy(pl) and not skippedPlayers[pl] and not hasValue(checkedList, pl) then
                local char = pl.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 and hrp.Position.Y <= 12000 and AX_ReadPvPState(pl) and not AX_InSafeZone(pl) then
                    local minLevel = tonumber(Flags["AutoBounty/MinLevel"]) or 0
                    local eligible = true
                    if minLevel > 0 then
                        local pLvl = getPlayerLevel(pl)
                        if pLvl > 0 and pLvl < minLevel then
                            eligible = false
                        end
                    end

                    if eligible then
                        candidateCount = candidateCount + 1
                        local dist = (hrp.Position - myPos).Magnitude
                        if dist < bestDist then
                            bestDist = dist
                            bestTarget = pl
                        end
                    end
                end
            end
        end

        -- If all targets in current sweep are exhausted, clear defeated targets while strictly preserving skipped players
        if not bestTarget and #checkedList > 0 then
            local remaining = {}
            for _, p in ipairs(checkedList) do
                if skippedPlayers[p] then
                    table.insert(remaining, p)
                end
            end
            getgenv().checked = remaining
        end

        return bestTarget, candidateCount
    end

    local function selectTarget(p)
        if not p or not p.Parent then return end
        if getgenv().targ == p then return end
        getgenv().targ = p
        getgenv().AutoBountyReachedTarget = false

        local bVal = 0
        local lstats = p:FindFirstChild("leaderstats")
        if lstats then
            local bStat = lstats:FindFirstChild("Bounty/Honor") or lstats:FindFirstChild("Bounty") or lstats:FindFirstChild("Honor")
            if bStat then bVal = tonumber(bStat.Value) or 0 end
        end

        if setTargetNameText then setTargetNameText(tostring(p.DisplayName or p.Name)) end
        if setTargetBountyText then setTargetBountyText(string.format("%.2fM", bVal / 1000000)) end
        updateTelemetryLog(string.format("[Hunt] Locked target: %s (%.2fM)", p.DisplayName or p.Name, bVal / 1000000))
    end

