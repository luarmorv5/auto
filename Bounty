Aurora.CheckInCombat = function()
    local inCombat = false
    pcall(function()
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        local main = playerGui and playerGui:FindFirstChild("Main")
        local bList = main and main:FindFirstChild("BottomHUDList")
        local ic = bList and bList:FindFirstChild("InCombat")
        if ic and ic.Visible then
            local txt = ""
            if ic:IsA("TextLabel") or ic:IsA("TextButton") then
                txt = tostring(ic.Text or ""):lower()
            else
                local tl = ic:FindFirstChildOfClass("TextLabel")
                txt = tl and tostring(tl.Text or ""):lower() or ""
            end
            if txt == "" or string.find(txt, "risk") or string.find(txt, "combat") or string.find(txt, "pvp") then
                inCombat = true
            end
        end
        if not inCombat and LocalPlayer.Character then
            if LocalPlayer.Character:GetAttribute("InCombat") == true then
                inCombat = true
            end
        end
        if not inCombat and LocalPlayer:GetAttribute("InCombat") == true then
            inCombat = true
        end
    end)
    return inCombat
end
