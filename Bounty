    local function GetFruitRemote()
        local char = LocalPlayer.Character
        if not char then return nil end

        local fruit = nil
        -- 1. Check equipped fruit in character
        for _, item in ipairs(char:GetChildren()) do
            if item:IsA("Tool") and (item:GetAttribute("WeaponType") == "Demon Fruit" or item:GetAttribute("WeaponType") == "Blox Fruit" or item.ToolTip == "Blox Fruit" or isToolMatchingType(item, "Blox Fruit")) then
                fruit = item
                break
            end
        end

        -- 2. If not equipped, find in Backpack and equip
        if not fruit then
            local backpack = LocalPlayer:FindFirstChild("Backpack")
            if backpack then
                for _, item in ipairs(backpack:GetChildren()) do
                    if item:IsA("Tool") and (item:GetAttribute("WeaponType") == "Demon Fruit" or item:GetAttribute("WeaponType") == "Blox Fruit" or item.ToolTip == "Blox Fruit" or isToolMatchingType(item, "Blox Fruit")) then
                        fruit = item
                        break
                    end
                end
                if fruit then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum then
                        hum:EquipTool(fruit)
                        task.wait(0.1)
                        for _, item in ipairs(char:GetChildren()) do
                            if item:IsA("Tool") and (item:GetAttribute("WeaponType") == "Demon Fruit" or item:GetAttribute("WeaponType") == "Blox Fruit" or item.ToolTip == "Blox Fruit" or isToolMatchingType(item, "Blox Fruit")) then
                                fruit = item
                                break
                            end
                        end
                    end
                end
            end
        end

        if not fruit then return nil end

        -- 3. Locate click RemoteEvent
        local remote = fruit:FindFirstChild("LeftClickRemote")
            or fruit:FindFirstChild("ClickRemote")
            or fruit:FindFirstChild("M1Remote")

        if not remote then
            for _, v in ipairs(fruit:GetChildren()) do
                if v:IsA("RemoteEvent") and (v.Name:lower():find("click") or v.Name:lower():find("m1")) then
                    remote = v
                    break
                end
            end
        end

        return remote
    end

