        if pressing and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            pressing = false
            if not moved then restore() end
        end
    end)
    MiniButton.MouseEnter:Connect(function()
        if isMinimized and not isAnimating then tween(MiniScale, TWEEN_FAST, {Scale = 1.08}) end
    end)
