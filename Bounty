-- LOOP (HUD + sesión + rainbow)
-- =============================================================================
local function getPing()
    local ok, v = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
    if ok and v then return math.floor(v) end
    local ok2, v2 = pcall(function() return LocalPlayer:GetNetworkPing() * 1000 end)
    return ok2 and math.floor(v2) or 0
end

local function formatTime(sec)
    sec = math.floor(sec)
    return string.format("%02d:%02d:%02d", math.floor(sec / 3600), math.floor(sec / 60) % 60, sec % 60)
end

do
    local frames, lastFps, lastSlow, lastRainbow = 0, os.clock(), 0, 0
    local fpsVal = 60
    local initialSessionBounty = nil
    local startTime = os.clock()
    local hue = 0

    connect(RunService.RenderStepped, function(dt)
    frames = frames + 1
    local now = os.clock()

    -- CamLock towards hunted target in combat (Rock-solid real-time tracking)
    pcall(function()
        if (bountyRunning or Aurora.Booleans.BountyRunning) and not getgenv().HealingInSky then
            local curTarg = getgenv().targ
            if curTarg and curTarg.Character then
                local tHrp = curTarg.Character:FindFirstChild("HumanoidRootPart")
                local tHum = curTarg.Character:FindFirstChildOfClass("Humanoid")
                if tHrp and tHum and tHum.Health > 0 and tHrp:IsA("BasePart") then
                    local cam = workspace.CurrentCamera
                    if cam then
                        local vel = tHrp.AssemblyLinearVelocity or tHrp.Velocity or Vector3.zero
                        local camTarget = tHrp.Position + (vel * 0.163186)
                        cam.CFrame = CFrame.new(cam.CFrame.Position, camTarget)
                    end
                end
            end
        end
    end)

    -- Animated Title Gradient (Only active on desktop when window is open to save mobile GPU)
    if not isMobile and not isMinimized and Main and Main.Visible then
        TitleGrad.Offset = Vector2.new(math.sin(now * 1.6) * 0.6, 0)
    end

    if now - lastFps >= 1 then
        fpsVal = frames
        frames, lastFps = 0, now
        if setSession then setSession(formatTime(now - startTime)) end
    end

    if now - lastSlow >= 0.35 then
        lastSlow = now
        if Hud.Visible then
            TimeLabel.Text = formatTime(now - startTime)
            FpsLabel.Text  = string.format("%d Fps", math.clamp(fpsVal or frames, 0, 240))
            PingLabel.Text = string.format("%d Ping", math.floor(getPing()))

            -- Bounty Pill: Bounty: Current (+Earned)
            pcall(function()
                local ls = LocalPlayer:FindFirstChild("leaderstats")
                local bStat = ls and (ls:FindFirstChild("Bounty/Honor") or ls:FindFirstChild("Bounty") or ls:FindFirstChild("Honor"))
                local current = bStat and tonumber(bStat.Value) or 0
                if not initialSessionBounty and current > 0 then
                    initialSessionBounty = current
                end
                local earned = initialSessionBounty and math.max(0, current - initialSessionBounty) or 0
                local earnedStr = earned >= 1000 and string.format("+%.1fk", earned / 1000) or ("+" .. tostring(earned))
                if current >= 1000000 then
                    BountyLabel.Text = string.format("Bounty: %.2fM (%s)", current / 1000000, earnedStr)
                elseif current > 0 then
                    BountyLabel.Text = string.format("Bounty: %s (%s)", tostring(current), earnedStr)
                else
                    BountyLabel.Text = "Bounty: ... (+0)"
                end
            end)

            -- Target Pill: Target: Name (HP%)
            pcall(function()
                local curT = getgenv().targ
                if curT and curT.Parent then
                    local tChar = curT.Character
                    local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
                    if tHum and tHum.Health > 0 then
                        local hpPct = math.clamp(math.floor((tHum.Health / math.max(1, tHum.MaxHealth)) * 100), 0, 100)
                        local tName = curT.DisplayName or curT.Name
                        if #tName > 10 then tName = string.sub(tName, 1, 9) .. ".." end
                        TargetLabel.Text = string.format("Target: %s (%d%%)", tName, hpPct)
                    else
                        TargetLabel.Text = "Target: None"
                    end
                else
                    TargetLabel.Text = (bountyRunning or Aurora.Booleans.BountyRunning) and "Target: Searching..." or "Target: None"
                end
            end)

            -- Combat Status Pill: PvP: Safe / PvP: IN COMBAT
            if Aurora.CheckInCombat() then
                CombatLabel.Text = "PvP: IN COMBAT"
                CombatLabel.TextColor3 = Color3.fromRGB(255, 75, 75)
            else
                CombatLabel.Text = "PvP: Safe"
                CombatLabel.TextColor3 = Color3.fromRGB(80, 250, 123)
            end
        end
    end

    -- Rainbow UI cycle
    if (Flags["Settings/RainbowUI"] or Flags["Colors/RainbowUI"]) and now - lastRainbow >= 0.05 then
        lastRainbow = now
        local speed = Flags["Settings/RainbowSpeed"] or Flags["Colors/RainbowSpeed"] or 3
        hue = (hue + 0.004 * speed) % 1
        setAccent(Color3.fromHSV(hue, 0.70, 1), true)
    end
end)
end

