    local lastFastAttackTime = 0
    local function executeFastAttackBurst()
        if not isCurrentSession() or getgenv().HealingInSky then return end
        local isOneShotKit = (Flags["AutoBounty/FruitsM1"] == true)
        if isOneShotKit then return end -- One Shot mode uses its own Kitsune M1 engine
        if isLocalPvpDisabled() then return end

        local chosenDelay = tonumber(Flags["AutoBounty/FastAttackDelay"]) or 0.08
        local requiredDelay = math.clamp(chosenDelay, 0.01, 0.5)
        local now = tick()
        if now - lastFastAttackTime < requiredDelay then return end
        lastFastAttackTime = now

        local myChar = LocalPlayer.Character
        local myHRP = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar.PrimaryPart)
        local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
        if not myHRP or not myHum or myHum.Health <= 0 then return end

        local currentTool = myChar:FindFirstChildOfClass("Tool")
        if not currentTool or currentTool.ToolTip == "Gun" then return end

        local isCasting = myChar:GetAttribute("isUsingSkill") or myChar:GetAttribute("UsingSkill") or myChar:GetAttribute("Busy")
        if isCasting == true then return end

        local myPos = myHRP.Position
        local hitList = {}

        local function checkEnemy(model)
            if not model or model == myChar then return end
            local hum = model:FindFirstChildOfClass("Humanoid")
            local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
            local head = model:FindFirstChild("Head") or hrp
            if hum and hum.Health > 0 and hrp and head and (hrp.Position - myPos).Magnitude <= 120 then
                table.insert(hitList, { model, head })
            end
        end

        local curTarg = getgenv().targ
        if curTarg and curTarg.Character then
            checkEnemy(curTarg.Character)
        end

        local charsFolder = workspace:FindFirstChild("Characters")
        if charsFolder and #hitList < 5 then
            for _, c in ipairs(charsFolder:GetChildren()) do
                if c ~= myChar and (not curTarg or c ~= curTarg.Character) then
                    checkEnemy(c)
                    if #hitList >= 5 then break end
                end
            end
        end

        if #hitList < 5 then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and (not curTarg or p.Character ~= curTarg.Character) then
                    checkEnemy(p.Character)
                    if #hitList >= 5 then break end
                end
            end
        end

        if #hitList > 0 then
            local primaryPart = hitList[1][2]
            local targetDir = (myHRP and myHRP.CFrame.LookVector) or Vector3.new(0, 0, 1)
            if primaryPart and primaryPart:IsA("BasePart") then
                targetDir = (primaryPart.Position - myPos).Unit
            end
            pcall(function()
                if currentTool:FindFirstChild("LeftClickRemote") then
                    currentTool.LeftClickRemote:FireServer(targetDir, 1)
                else
                    if resolveAttackRemotes() then
                        RegisterAttack:FireServer(0)
                        RegisterHit:FireServer(primaryPart, hitList)
                    end
                end
            end)
        end
    end

