-- AUTO BOUNTY ENGINE STATE & SESSION CONTROLLER
-- =============================================================================
local SCRIPT_SESSION = tick()
_G.AuroraX_Session = SCRIPT_SESSION
local function isCurrentSession()
    return _G.AuroraX_Session == SCRIPT_SESSION
end

if _G.AuroraX_SessionCleanup then
    pcall(_G.AuroraX_SessionCleanup)
end

local sessionConnections = {}
local function sessionConnect(signal, callback)
    if not isCurrentSession() then return nil end
    local conn = signal:Connect(function(...)
        if isCurrentSession() then callback(...) end
    end)
    table.insert(sessionConnections, conn)
    return conn
end

_G.AuroraX_SessionCleanup = function()
    for _, conn in ipairs(sessionConnections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(sessionConnections)
    pcall(function()
        if _G.AuroraX_CleanupESP then _G.AuroraX_CleanupESP() end
    end)
end


